{
  "manifest_version": 3,
  "name": "LostFilmTrack",
  "version": "1.0",
  "description": "Свежие серии и фильмы с LostFilm за 24 часа или неделю",
  "permissions": [],
  "host_permissions": [
    "*://*.lostfilm.download/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LostFilmTrack",
    "default_icon": {
      "16": "favicon-16x16.png",
      "32": "favicon-32x32.png",
      "48": "apple-touch-icon.png",
      "128": "apple-touch-icon.png"
    }
  },
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png",
    "48": "apple-touch-icon.png",
    "128": "apple-touch-icon.png"
  }
}
